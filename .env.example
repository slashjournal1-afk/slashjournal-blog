# =============================================================================
# SLASHJOURNAL ENVIRONMENT TEMPLATE — SUPABASE & NEXT.JS
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL="https://[NEW_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[NEW_PUBLISHABLE_KEY]"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[NEW_PUBLISHABLE_KEY]"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# Session Mode Pooler (Port 5432 - untuk Prisma CLI / db push)
DIRECT_URL="postgresql://postgres.[NEW_PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Transaction Mode Pooler (Port 6543 - untuk Runtime Query)
DATABASE_URL="postgresql://postgres.[NEW_PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&prepared_statements=false&connection_limit=3&pool_timeout=10&connect_timeout=5"

# Database Lama untuk Migrasi Data (Old Supabase)
OLD_DATABASE_URL="postgresql://postgres.[OLD_PROJECT_REF]:[OLD_URL_ENCODED_PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

JWT_SECRET="your-super-secret-jwt-token-key-here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://www.slashjournal.my.id"
NODE_ENV="development"
