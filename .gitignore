# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Output
/.next/
/out/
/build
/dist

# Environment & Secrets (Never commit production credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Local SQLite / Dev Databases
/prisma/*.db
/prisma/*.db-journal
/prisma/*.sqlite
*.sqlite3

# Public Uploads (User generated media in local storage)
/public/uploads/*
!/public/uploads/.gitkeep

# Temporary & Scratch Files
/scratch/
*.tmp
*.temp

# TypeScript & Build Info
*.tsbuildinfo
next-env.d.ts.bak

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# OS & Editor Artifacts
.DS_Store
Thumbs.db
*.pem
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel & Turborepo
.vercel
.turbo
